<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Global admin banner when the delayed purge queue is backlogged or its cron looks stalled -->
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="stacknuts_cloudflarecache_queue_backlog" xsi:type="string">StackNuts\CloudflareCache\Model\System\Message\QueueBacklog</item>
            </argument>
        </arguments>
    </type>
</config>
