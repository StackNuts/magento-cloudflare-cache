<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="stacknuts_cloudflarecache_purge_queue" resource="default" engine="innodb"
           comment="Pending Cloudflare cache-tag purges awaiting the delayed-drain cron (StackNuts_CloudflareCache::Cron::DrainPurgeQueue)">
        <column xsi:type="int" name="queue_id" unsigned="true" nullable="false" identity="true" comment="Queue ID"/>
        <column xsi:type="varchar" name="tag" nullable="false" length="255" comment="Cache Tag"/>
        <column xsi:type="int" name="attempts" unsigned="true" nullable="false" identity="false" default="0" comment="Failed Purge Attempts"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="queue_id"/>
        </constraint>
    </table>
</schema>
